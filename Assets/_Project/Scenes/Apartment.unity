  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Radio.UI.ComputerDesktop
  icons:
  - title: "\u042D\u0444\u0438\u0440\u043D\u0430\u044F \u0441\u0435\u0442\u043A\u0430"
    button: {fileID: 726819024}
    body: "\u0421\u0435\u0442\u043A\u0430 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u0430.\n\n\u0417\u0434\u0435\u0441\u044C
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u044D\u0444\u0438\u0440\u0430: \u043C\u0443\u0437\u044B\u043A\u0430, \u0440\u0435\u043A\u043B\u0430\u043C\u0430,
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438 \u0438 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    program: {fileID: 0}
  - title: "\u0416\u0443\u0440\u043D\u0430\u043B \u0441\u043C\u0435\u043D"
    button: {fileID: 1086636578}
    body: "\u0416\u0443\u0440\u043D\u0430\u043B \u0441\u043C\u0435\u043D.\n\n\u0417\u0430\u043F\u0438\u0441\u044C
      \u0437\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F: \u043F\u043E\u0434\u043C\u0435\u043D\u0430.
      \u0424\u0430\u043C\u0438\u043B\u0438\u044F \u0432\u043F\u0438\u0441\u0430\u043D\u0430
      \u0447\u0443\u0436\u043E\u0439 \u0440\u0443\u043A\u043E\u0439."
