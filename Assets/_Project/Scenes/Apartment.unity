  endings:
  - stat: Crime
    atMax: 1
    text: "\u041A\u041E\u041D\u0426\u041E\u0412\u041A\u0410 \xAB\u0421\u043E\u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\xBB\n\u041A\u0440\u0438\u043C\u0438\u043D\u0430\u043B
