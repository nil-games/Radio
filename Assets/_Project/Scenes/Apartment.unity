  m_Script: {fileID: 11500000, guid: 8b035ffb926502543b7157a5f04494f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Radio.UI.ComputerMail
  messages:
  - arrivedFlag: STORY_POLICE_MAIL_ARRIVED
    readFlag: KNOW_POLICE_MISSING_GIRL
    completesTask: check_computer
    timeAfterRead: 02:00
    from: miliziy@.ru
    subject: "\u0420\u0410\u0417\u042B\u0421\u041A\u0418\u0412\u0410\u0415\u0422\u0421\u042F
      \u0427\u0415\u041B\u041E\u0412\u0415\u041A"
    sentAt: 01:00
    text: "\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415\n\u041F\u0440\u043E\u0441\u0438\u043C
      \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432 \u044D\u0444\u0438\u0440\u0435
      \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043E \u043F\u0440\u043E\u043F\u0430\u0436\u0435
      \u0434\u0435\u0432\u0443\u0448\u043A\u0438.\n\n\u0418\u043C\u044F: \u0410\u043B\u0438\u0441\u0430\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442:
      24 \u0433\u043E\u0434\u0430.\n\u0420\u043E\u0441\u0442: 172 \u0441\u043C.\n\u0412\u043E\u043B\u043E\u0441\u044B:
      \u0431\u0435\u043B\u044B\u0435.\n\u041E\u0434\u0435\u0436\u0434\u0430: \u043A\u0440\u0430\u0441\u043D\u0430\u044F
      \u043A\u0443\u0440\u0442\u043A\u0430, \u0441\u0438\u043D\u0438\u0435 \u0434\u0436\u0438\u043D\u0441\u044B,
      \u0447\u0451\u0440\u043D\u0430\u044F \u043A\u0435\u043F\u043A\u0430.\n\n\u041F\u0440\u0438
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0430
      \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u043F\u043E \u043D\u043E\u043C\u0435\u0440\u0443
      02.\n\n\u041C\u0423\u041D\u0418\u0426\u0418\u041F\u0410\u041B\u042C\u041D\u0410\u042F
      \u041F\u041E\u041B\u0418\u0426\u0418\u042F"
  - arrivedFlag: STORY_N2_POLICE_MAIL_ARRIVED
    readFlag: KNOW_N2_WITNESS_AD
    completesTask: 
    timeAfterRead: 
    from: "\u041B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442 \u041A\u0440\u0430\u0432\u0435\u0446"
    subject: "\u041F\u041E\u041B\u0418\u0426\u0418\u042F \u0418\u0429\u0415\u0422
      \u0421\u0412\u0418\u0414\u0415\u0422\u0415\u041B\u0415\u0419"
    sentAt: 01:00
    text: "\u041F\u0440\u043E\u0448\u0443 \u0434\u0430\u0442\u044C \u0432 \u044D\u0444\u0438\u0440\u0435
      \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435:\n\n\u041F\u041E\u041B\u0418\u0426\u0418\u042F
      \u0418\u0429\u0415\u0422 \u0421\u0412\u0418\u0414\u0415\u0422\u0415\u041B\u0415\u0419\n\u041F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043D\u043E\u0447\u044C\u044E \u043E\u043A\u043E\u043B\u043E 3:20 \u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430
      \xAB\u0423 \u0412\u043E\u0432\u044B\xBB \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430
      \u0434\u0440\u0430\u043A\u0430. \u0412\u0438\u0434\u0435\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u2014 \u0437\u0432\u043E\u043D\u0438\u0442\u0435 02.\n\n\u041B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442
      \u041A\u0440\u0430\u0432\u0435\u0446"
  emptyText: "\u041D\u043E\u0432\u044B\u0445 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439
    \u043D\u0435\u0442."
  font: {fileID: 11400000, guid: 6c5e9203b12089442bf3874fd89c1b7c, type: 2}
  rowHeight: 64
  rowColor: {r: 1, g: 1, b: 1, a: 0.08}
